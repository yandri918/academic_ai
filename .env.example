# ============================================
# AcademAI — Environment Variables
# ============================================
# File ini adalah TEMPLATE.
# Salin menjadi .env untuk local dev:
#   Copy-Item .env.example .env
#
# Untuk Railway: isi langsung di dashboard
#   Railway → Project → Service → Variables
# ============================================

# ── WAJIB (Railway & Local) ───────────────────

# Anthropic API Key (Claude)
# Daftar di: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-GANTI_DENGAN_API_KEY_ANDA

# Kunci enkripsi n8n — buat random 32 karakter
# Generate: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 32 | % {[char]$_})
N8N_ENCRYPTION_KEY=academ_ai_secret_key_32chars_here

# ── WAJIB (Railway only) ──────────────────────

# URL publik Railway yang diberikan Railway Dashboard.
# Format: https://<nama-app>.up.railway.app
# Penting: tanpa trailing slash
WEBHOOK_URL=https://GANTI-DENGAN-URL-RAILWAY.up.railway.app
N8N_EDITOR_BASE_URL=https://GANTI-DENGAN-URL-RAILWAY.up.railway.app

# ── CORS — wajib di Railway ───────────────────
# Izinkan frontend (localhost:8080 atau domain Anda) akses webhook
N8N_CORS_ENABLE=true
N8N_CORS_ALLOWED_ORIGINS=*

# ── n8n Auth ──────────────────────────────────
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
# Ganti dengan password kuat untuk Railway!
N8N_BASIC_AUTH_PASSWORD=AcademAI_2024_Kuat!

# ── OPSIONAL ──────────────────────────────────

# Semantic Scholar API Key (gratis, opsional)
# Tanpa key: 100 req/5 menit | Dengan key: 1 req/detik
# Daftar di: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Timezone
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# n8n Logging
N8N_LOG_LEVEL=info
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_RUNNERS_ENABLED=true
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
